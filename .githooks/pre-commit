#!/usr/bin/env bash
# pre-commit: catch hardcoded domain strings in the staged index blobs of .ts/.tsx files.
# Reads each file from the Git index (`git show ":$file"`) — not the working tree —
# so only what is actually being committed is checked.
#
# The staged blob is written to a temp file before grepping to avoid the
# SIGPIPE / pipefail interaction: `git show … | grep -q` exits with a non-zero
# pipeline status when grep exits early on a match in a large file, causing
# false negatives under `set -o pipefail`.
#
# Installed automatically via `prepare` in package.json (git config core.hooksPath .githooks).

set -euo pipefail

# ── OG image coverage check ───────────────────────────────────────────────────
# Runs whenever src/lib/games.ts, the OG registry, or any route file is staged.
#
# Uses check-og-coverage-staged.mjs (not check-og-coverage.mjs) because the
# staged variant reads all three sources — games.ts, og-game-registry.mjs, and
# PNG existence — from the git INDEX, not the working tree.  This catches the
# common mistake of generating images but forgetting to `git add` them.
#
# Authoritative source: src/lib/games.ts (the GAMES array `to:` slugs).
# A route file in src/routes/ is NOT a "game" until registered in games.ts;
# new route files still trigger this check so developers are reminded to update
# both the games registry and the OG registry together.
OG_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '^(src/lib/games\.ts|scripts/og-game-registry\.mjs|src/routes/.+\.tsx)$' || true)

if [[ -n "${OG_TRIGGER}" ]]; then
  echo "==> Checking OG image coverage (staged index — no build required)…"
  if ! node scripts/check-og-coverage-staged.mjs; then
    echo "" >&2
    echo "Commit blocked: update the OG registry, regenerate images, and stage the PNGs." >&2
    echo "  1. Edit scripts/og-game-registry.mjs (add the new game)" >&2
    echo "  2. node scripts/generate-og-images.mjs" >&2
    echo "  3. git add public/og/<slug>.png" >&2
    echo "" >&2
    exit 1
  fi
fi

# ── Sitemap auto-regeneration ─────────────────────────────────────────────────
# Runs whenever guides.ts (guide registry) or any route file is staged so the
# sitemap never drifts after a new guide or page is added.
SITEMAP_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '^(src/lib/guides\.ts|src/routes/.+\.tsx)$' || true)

if [[ -n "${SITEMAP_TRIGGER}" ]]; then
  echo "==> Regenerating sitemap.xml…"
  if ! bun run scripts/generate-sitemap.ts; then
    echo "Commit blocked: sitemap generation failed." >&2
    exit 1
  fi
  git add public/sitemap.xml
  echo "    public/sitemap.xml updated and staged."
fi

DOMAIN="free-klondike-solitaire\.com"
ALLOWED="src/lib/site.ts"

# Collect staged .ts/.tsx files (excluding deletions)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)

if [[ -z "${STAGED}" ]]; then
  exit 0
fi

# Temp file receives each staged blob; grepping the file avoids SIGPIPE
TMPFILE=$(mktemp)
trap 'rm -f "${TMPFILE}"' EXIT

FAIL=0
while IFS= read -r file; do
  # Skip the canonical definition file
  if [[ "${file}" == "${ALLOWED}" ]]; then
    continue
  fi
  # Write the staged index blob to a temp file, then grep the file (no pipe)
  if git show ":${file}" > "${TMPFILE}" 2>/dev/null && grep -q "${DOMAIN}" "${TMPFILE}"; then
    if [[ "${FAIL}" -eq 0 ]]; then
      echo "" >&2
      echo "ERROR: Hardcoded domain 'free-klondike-solitaire.com' found in staged file(s):" >&2
    fi
    echo "  ${file}" >&2
    FAIL=1
  fi
done <<< "${STAGED}"

if [[ "${FAIL}" -ne 0 ]]; then
  echo "Use the SITE_URL constant from @/lib/site instead." >&2
  echo "" >&2
  exit 1
fi

exit 0
